GATEWAY_HTTP_ADDR=:8080
GATEWAY_AUTH_URL=http://localhost:8081
GATEWAY_PROFILE_URL=http://localhost:8082
GATEWAY_CORE_URL=http://localhost:8083
GATEWAY_GAME_URL=http://localhost:8084
GATEWAY_CHAT_URL=http://localhost:8085
# Required: set each actual full health endpoint URL.
GATEWAY_AUTH_HEALTH_URL=http://localhost:8081/api/v1/health
# GATEWAY_PROFILE_HEALTH_URL=http://localhost:8082/<health-path>
# GATEWAY_CORE_HEALTH_URL=http://localhost:8083/<health-path>
# GATEWAY_GAME_HEALTH_URL=http://localhost:8084/<health-path>
# GATEWAY_CHAT_HEALTH_URL=http://localhost:8085/<health-path>
GATEWAY_CORE_TIMEOUT=10s
GATEWAY_AUTH_TIMEOUT=10s
GATEWAY_PROFILE_TIMEOUT=10s
GATEWAY_GAME_TIMEOUT=10s
GATEWAY_CHAT_TIMEOUT=10s
GATEWAY_HEALTH_TIMEOUT=2s
REDIS_ADDR=localhost:6379
# REDIS_PASSWORD must match the password configured for the shared Redis.
# JWT_SECRET must match Auth's UTF-8 signing secret.
# REDIS_PASSWORD=replace-me
# JWT_SECRET=replace-me
GATEWAY_READ_HEADER_TIMEOUT=5s
GATEWAY_READ_TIMEOUT=15s
GATEWAY_WRITE_TIMEOUT=15s
GATEWAY_IDLE_TIMEOUT=60s
GATEWAY_SHUTDOWN_TIMEOUT=10s
GATEWAY_LOG_LEVEL=info
